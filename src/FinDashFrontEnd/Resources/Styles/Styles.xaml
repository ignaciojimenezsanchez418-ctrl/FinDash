<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<!--
    Estilos de FinDash CR.
    Fuentes: InterRegular / InterMedium / InterSemiBold / InterBold para texto,
             MonoMedium / MonoSemiBold (Roboto Mono) para montos, Icons para íconos.
    Escala: 32 patrimonio · 22 título · 17 sección · 15 texto · 13 secundario.
    Espaciado en múltiplos de 4, margen lateral 16, toques de al menos 44.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ===================== Implícitos ===================== -->

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{DynamicResource BgColor}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Shell.NavBarIsVisible" Value="False" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{DynamicResource SurfaceColor}" />
        <Setter Property="Shell.ForegroundColor" Value="{DynamicResource TextColor}" />
        <Setter Property="Shell.TitleColor" Value="{DynamicResource TextColor}" />
        <Setter Property="Shell.DisabledColor" Value="{DynamicResource TextMutedColor}" />
        <Setter Property="Shell.UnselectedColor" Value="{DynamicResource TextMutedColor}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{DynamicResource SurfaceColor}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{DynamicResource PrimaryColor}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{DynamicResource PrimaryColor}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{DynamicResource TextMutedColor}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{DynamicResource TextColor}" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{DynamicResource TextColor}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource TextMutedColor}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{DynamicResource TextColor}" />
        <Setter Property="TitleColor" Value="{DynamicResource TextMutedColor}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{DynamicResource TextColor}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{DynamicResource PrimaryColor}" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{DynamicResource PrimaryColor}" />
    </Style>

    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{DynamicResource PrimaryColor}" />
    </Style>

    <Style TargetType="ScrollView">
        <Setter Property="VerticalScrollBarVisibility" Value="Never" />
    </Style>

    <!-- Botón principal (relleno azul) -->
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{DynamicResource OnPrimaryColor}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryColor}" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource TextMutedColor}" />
                            <Setter Property="BackgroundColor" Value="{DynamicResource Surface2Color}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- ===================== Botones con nombre ===================== -->

    <!-- Fondo azul suave, texto azul: acciones secundarias ("Agregar") -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{DynamicResource PrimaryColor}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource PrimarySoftColor}" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <Style x:Key="SmallSecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,0" />
    </Style>

    <!-- Borde gris, sin relleno -->
    <Style x:Key="OutlineButton" TargetType="Button">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{DynamicResource TextColor}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderColor" Value="{DynamicResource BorderColor}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <Style x:Key="SmallOutlineButton" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="TextColor" Value="{DynamicResource TextMutedColor}" />
    </Style>

    <!-- Acciones destructivas: cerrar sesión, eliminar -->
    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{DynamicResource LossColor}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource LossSoftColor}" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <!-- Enlace de texto -->
    <Style x:Key="TextButton" TargetType="Button">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{DynamicResource PrimaryColor}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="Padding" Value="8,0" />
    </Style>

    <!-- Botón redondo con ícono (campana, cerrar) -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="FontFamily" Value="Icons" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="TextColor" Value="{DynamicResource TextColor}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
        <Setter Property="BorderColor" Value="{DynamicResource BorderColor}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Ícono sin fondo (flecha atrás) -->
    <Style x:Key="NavIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="FontSize" Value="24" />
    </Style>

    <!-- Botón flotante (+) -->
    <Style x:Key="Fab" TargetType="Button">
        <Setter Property="FontFamily" Value="Icons" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="TextColor" Value="{DynamicResource OnPrimaryColor}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryColor}" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="WidthRequest" Value="56" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalOptions" Value="End" />
        <Setter Property="VerticalOptions" Value="End" />
        <Setter Property="Margin" Value="0,0,16,16" />
        <Setter Property="Shadow">
            <Shadow Brush="Black" Opacity="0.18" Radius="12" Offset="0,4" />
        </Setter>
    </Style>

    <!-- ===================== Textos con nombre ===================== -->

    <!-- Patrimonio y precios grandes -->
    <Style x:Key="DisplayText" TargetType="Label">
        <Setter Property="FontFamily" Value="MonoSemiBold" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="CharacterSpacing" Value="-0.8" />
        <Setter Property="TextColor" Value="{DynamicResource TextColor}" />
    </Style>

    <Style x:Key="TitleText" TargetType="Label">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="TextColor" Value="{DynamicResource TextColor}" />
    </Style>

    <Style x:Key="SectionText" TargetType="Label">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="TextColor" Value="{DynamicResource TextColor}" />
    </Style>

    <Style x:Key="BodyText" TargetType="Label">
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{DynamicResource TextColor}" />
    </Style>

    <Style x:Key="BodyMedium" TargetType="Label" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontFamily" Value="InterMedium" />
    </Style>

    <Style x:Key="BodyStrong" TargetType="Label" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontFamily" Value="InterSemiBold" />
    </Style>

    <Style x:Key="CaptionText" TargetType="Label">
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{DynamicResource TextMutedColor}" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="InterMedium" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{DynamicResource TextMutedColor}" />
    </Style>

    <Style x:Key="ErrorText" TargetType="Label">
        <Setter Property="FontFamily" Value="InterMedium" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{DynamicResource LossColor}" />
    </Style>

    <!-- Montos en listas -->
    <Style x:Key="MonoText" TargetType="Label">
        <Setter Property="FontFamily" Value="MonoMedium" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{DynamicResource TextColor}" />
    </Style>

    <Style x:Key="MonoCaption" TargetType="Label">
        <Setter Property="FontFamily" Value="MonoMedium" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{DynamicResource TextMutedColor}" />
    </Style>

    <Style x:Key="MonoStrong" TargetType="Label">
        <Setter Property="FontFamily" Value="MonoSemiBold" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="TextColor" Value="{DynamicResource TextColor}" />
    </Style>

    <Style x:Key="IconText" TargetType="Label">
        <Setter Property="FontFamily" Value="Icons" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="TextColor" Value="{DynamicResource TextColor}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="AvatarText" TargetType="Label">
        <Setter Property="FontFamily" Value="MonoSemiBold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="{DynamicResource PrimaryColor}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- ===================== Contenedores ===================== -->

    <Style TargetType="Border">
        <Setter Property="Stroke" Value="{DynamicResource BorderColor}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="Rectangle" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
        <Setter Property="Stroke" Value="{DynamicResource BorderColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <!-- Tarjeta que contiene una lista: las filas ponen su propio relleno -->
    <Style x:Key="CardList" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Caja de un campo de formulario -->
    <Style x:Key="FieldBox" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
        <Setter Property="Stroke" Value="{DynamicResource BorderColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="MinimumHeightRequest" Value="52" />
    </Style>

    <!-- Círculo con el símbolo del activo -->
    <Style x:Key="Avatar" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource PrimarySoftColor}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="WidthRequest" Value="40" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Bloque gris mientras carga -->
    <Style x:Key="Skeleton" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource Surface2Color}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
    </Style>

    <Style x:Key="Divider" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{DynamicResource BorderColor}" />
    </Style>

</ResourceDictionary>
