<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FinDashFrontEnd.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:FinDashFrontEnd.Views"
    xmlns:t="clr-namespace:FinDashFrontEnd.Theme"
    Shell.FlyoutBehavior="Disabled"
    Title="FinDash CR">

    <!-- Sin sesión: //login (Crear cuenta se abre encima con la ruta "register") -->
    <ShellContent Route="login" ContentTemplate="{DataTemplate views:LoginPage}" />

    <!-- Con sesión: barra inferior con 4 pestañas -->
    <TabBar Route="main">
        <ShellContent Title="Inicio" Route="home" ContentTemplate="{DataTemplate views:HomePage}">
            <ShellContent.Icon>
                <FontImageSource FontFamily="Icons" Glyph="{x:Static t:Icons.Home}" Size="24" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent Title="Portafolio" Route="portfolio" ContentTemplate="{DataTemplate views:PortfolioPage}">
            <ShellContent.Icon>
                <FontImageSource FontFamily="Icons" Glyph="{x:Static t:Icons.PieChart}" Size="24" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent Title="Alertas" Route="alerts" ContentTemplate="{DataTemplate views:AlertsPage}">
            <ShellContent.Icon>
                <FontImageSource FontFamily="Icons" Glyph="{x:Static t:Icons.Notifications}" Size="24" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent Title="Ajustes" Route="settings" ContentTemplate="{DataTemplate views:SettingsPage}">
            <ShellContent.Icon>
                <FontImageSource FontFamily="Icons" Glyph="{x:Static t:Icons.Settings}" Size="24" />
            </ShellContent.Icon>
        </ShellContent>
    </TabBar>
</Shell>
