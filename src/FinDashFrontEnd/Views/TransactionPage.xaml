<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinDashFrontEnd.ViewModels"
             xmlns:c="clr-namespace:FinDashFrontEnd.Controls"
             xmlns:t="clr-namespace:FinDashFrontEnd.Theme"
             x:Class="FinDashFrontEnd.Views.TransactionPage"
             x:DataType="vm:TransactionViewModel"
             Shell.PresentationMode="ModalAnimated"
             Title="Nueva transacción">

    <Grid RowDefinitions="Auto,*,Auto">

        <Grid ColumnDefinitions="*,Auto" Padding="16,16,16,8">
            <Label Text="Nueva transacción" Style="{StaticResource TitleText}" VerticalOptions="Center"
                   SemanticProperties.HeadingLevel="Level1" />
            <Button Grid.Column="1" Text="{x:Static t:Icons.Close}" Style="{StaticResource IconButton}"
                    Command="{Binding BackCommand}" SemanticProperties.Description="Cerrar" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,8,16,24" Spacing="16">

                <c:SegmentedControl Items="{Binding TypeOptions}" SelectedIndex="{Binding TypeIndex}" />

                <!-- Activo -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Activo" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource FieldBox}">
                        <Picker ItemsSource="{Binding Assets}" SelectedItem="{Binding SelectedAsset}"
                                Title="Elegir activo" SemanticProperties.Description="Activo" />
                    </Border>
                    <Label Text="{Binding AvailableText}" Style="{StaticResource CaptionText}" />
                </VerticalStackLayout>

                <!-- Cantidad -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Cantidad" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource FieldBox}">
                        <Entry Text="{Binding QuantityText}" Keyboard="Numeric" Placeholder="0,00"
                               FontFamily="MonoMedium" SemanticProperties.Description="Cantidad" />
                    </Border>
                    <Label Text="{Binding QuantityError}" IsVisible="{Binding HasQuantityError}" Style="{StaticResource ErrorText}" />
                </VerticalStackLayout>

                <!-- Precio unitario -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Precio por unidad" Style="{StaticResource FieldLabel}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Border Style="{StaticResource FieldBox}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                <Label Text="{Binding CurrencySymbol}" Style="{StaticResource MonoText}" VerticalOptions="Center"
                                       TextColor="{DynamicResource TextMutedColor}" />
                                <Entry Grid.Column="1" Text="{Binding UnitPriceText}" Keyboard="Numeric"
                                       FontFamily="MonoMedium" SemanticProperties.Description="Precio por unidad" />
                            </Grid>
                        </Border>
                        <c:SegmentedControl Grid.Column="1" WidthRequest="132" VerticalOptions="Center" Margin="8,0,0,0"
                                            Items="{Binding CurrencyOptions}" SelectedIndex="{Binding CurrencyIndex}"
                                            IsVisible="{Binding CanChooseCurrency}" />
                    </Grid>
                    <Label Text="{Binding PriceHint}" Style="{StaticResource CaptionText}" />
                </VerticalStackLayout>

                <!-- Comisión -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Comisión (opcional)" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource FieldBox}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                            <Label Text="{Binding CurrencySymbol}" Style="{StaticResource MonoText}" VerticalOptions="Center"
                                   TextColor="{DynamicResource TextMutedColor}" />
                            <Entry Grid.Column="1" Text="{Binding FeeText}" Keyboard="Numeric" Placeholder="0"
                                   FontFamily="MonoMedium" SemanticProperties.Description="Comisión" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Fecha -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Fecha" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource FieldBox}">
                        <DatePicker Date="{Binding Date}" MaximumDate="{Binding MaxDate}" Format="dd/MM/yyyy"
                                    SemanticProperties.Description="Fecha" />
                    </Border>
                </VerticalStackLayout>

                <!-- Total -->
                <Border Style="{StaticResource Card}" Padding="20,16">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Total" Style="{StaticResource BodyMedium}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding TotalText}" Style="{StaticResource MonoStrong}" />
                    </Grid>
                </Border>

                <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorText}" />
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" Padding="16,8,16,16">
            <Button Text="{Binding SaveText}" Command="{Binding SaveCommand}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               Color="{DynamicResource OnPrimaryColor}" HeightRequest="24"
                               HorizontalOptions="End" Margin="0,0,16,0" />
        </Grid>
    </Grid>
</ContentPage>
