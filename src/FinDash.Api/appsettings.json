{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=findash.db"
  },
  "Jwt": {
    "Issuer": "FinDash",
    "Audience": "FinDash.App",
    "ExpirationDays": 7
  },
  "Providers": {
    "Mode": "Auto"
  },
  "CoinGecko": {
    "BaseUrl": "https://api.coingecko.com/api/v3/",
    "MaxCallsPerMinute": 25
  },
  "Bccr": {
    "BaseUrl": "https://gee.bccr.fi.cr/Indicadores/Suscripciones/WS/wsindicadoreseconomicos.asmx/",
    "Name": "FinDash"
  },
  "Prices": {
    "CryptoRefreshMinutes": 5,
    "FxRefreshHours": 6
  },
  "Alerts": {
    "EvaluateEverySeconds": 60,
    "CooldownMinutes": 60
  },
  "Workers": {
    "Enabled": true
  },
  "RateLimiting": {
    "AuthPerMinute": 10
  }
}
